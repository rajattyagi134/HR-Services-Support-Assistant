# Copy this file to .env and adjust values.

# "dev" -> uses local Ollama (free, offline). "prod" -> uses OpenAI.
ENV=dev

# Force a specific provider instead of the ENV default: "ollama" | "openai"
# LLM_PROVIDER=ollama

# --- Ollama (local, dev) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- OpenAI (prod) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Storage ---
CHROMA_DIR=data/chroma_db
PDF_DIR=data/pdfs

# --- RAG / Guardrails tuning ---
TOP_K=4
MAX_INPUT_CHARS=2000
MIN_RELEVANT_SCORE=0.3

# --- Escalation email (MailHog for local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=hr-support-bot@example.com
IT_TEAM_EMAIL=it-support@example.com
PAYROLL_TEAM_EMAIL=payroll@example.com
HR_TEAM_EMAIL=hr-team@example.com
